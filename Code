<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Zen Bubble Pop Pro</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            /* Relaxing deep-sea gradient */
            background: linear-gradient(180deg, #1a2a6c, #2a4858, #1a2a6c);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            font-family: 'Helvetica Neue', sans-serif;
            touch-action: none;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        #ui-layer {
            position: absolute;
            top: 20px;
            width: 100%;
            text-align: center;
            color: white;
            z-index: 10;
            pointer-events: none;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        #score-display { font-size: 1.5rem; opacity: 0.8; }

        .bubble {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(2px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            animation: float Upwards linear forwards;
        }

        @keyframes float {
            0% { transform: translateY(110vh) scale(1); opacity: 0; }
            20% { opacity: 0.6; }
            100% { transform: translateY(-20vh) scale(1.5); opacity: 0; }
        }

        .popping { animation: pop 0.2s ease-out forwards !important; }
        @keyframes pop { to { transform: scale(2); opacity: 0; } }
    </style>
</head>
<body>

    <div id="ui-layer">
        <div id="score-display">Zen: 0</div>
    </div>
    <div id="game-container"></div>

    <script>
        const container = document.getElementById('game-container');
        const scoreElement = document.getElementById('score-display');
        let score = 0;

        // 1. Synth Sound Engine (Generates a soft 'plink')
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playPopSound() {
            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();

            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(600 + Math.random() * 200, audioCtx.currentTime);

            gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.1);

            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);

            oscillator.start();
            oscillator.stop(audioCtx.currentTime + 0.1);
        }

        function createBubble() {
            const bubble = document.createElement('div');
            const size = Math.random() * 60 + 30;
            const posX = Math.random() * (window.innerWidth - size);
            const duration = Math.random() * 5 + 5;

            bubble.className = 'bubble';
            bubble.style.width = `${size}px`;
            bubble.style.height = `${size}px`;
            bubble.style.left = `${posX}px`;
            bubble.style.animationDuration = `${duration}s`;

            // Mobile & Desktop support
            const handleInteraction = (e) => {
                e.preventDefault();
                if (audioCtx.state === 'suspended') audioCtx.resume();
                popBubble(bubble);
            };

            bubble.addEventListener('touchstart', handleInteraction);
            bubble.addEventListener('mousedown', handleInteraction);

            container.appendChild(bubble);
            setTimeout(() => { if(bubble.parentNode) container.removeChild(bubble); }, duration * 1000);
        }

        function popBubble(bubble) {
            if (bubble.classList.contains('popping')) return;

            bubble.classList.add('popping');
            playPopSound();

            score++;
            scoreElement.innerText = `Zen: ${score}`;

            setTimeout(() => {
                if(bubble.parentNode) container.removeChild(bubble);
            }, 200);
        }

        setInterval(createBubble, 700);
    </script>
</body>
</html>
